# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.*.local
server/.env
client/.env

# Build outputs
dist/
build/
client/dist/
coverage/
*.tsbuildinfo

# SQLite runtime database files
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
*.sqlite
*.sqlite3

# Runtime uploaded user files (keep seeded assets tracked via server/public/assets)
server/uploads/*
!server/uploads/.gitkeep

# Logs & OS files
logs/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
