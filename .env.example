# =============================================================================
# V.I.R.A Pardazesh Hoomaan (VPHLabs.com) — Environment Configuration Template
# Copy to `.env` for local development. NEVER commit `.env` to Git.
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
SITE_URL=https://vphlabs.com
CLIENT_ORIGIN=http://localhost:5173

# SQLite Database & Uploads Directory (mount a Persistent Disk at /app/storage on Runflare)
SQLITE_DB_PATH=./data/vphlabs.db
UPLOADS_DIR=./uploads

# Authentication & Security
JWT_SECRET=change-this-to-a-cryptographically-secure-64-char-secret-in-prod
JWT_EXPIRES_IN=12h
COOKIE_SECURE=false

# Initial Seed Admin Credentials (used only on first seed if user doesn't exist)
SEED_ADMIN_EMAIL=VPHAdmin
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
SEED_ADMIN_NAME=شهرام امیری

# File Upload Storage Driver: 'local' or 's3' (ArvanCloud / MinIO / AWS S3 compatible)
STORAGE_DRIVER=local
MAX_UPLOAD_SIZE_MB=5
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_BUCKET=vphlabs-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Error Tracking (Sentry) — leave empty to disable in local dev
SENTRY_DSN=
VITE_SENTRY_DSN=

# Privacy-friendly Analytics (Umami) — leave empty to disable external script in dev
VITE_UMAMI_SRC=https://cloud.umami.is/script.js
VITE_UMAMI_WEBSITE_ID=
